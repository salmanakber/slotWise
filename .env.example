# =============================================================================
# Slotwise environment
# Copy to .env and fill in real values:
#   cp .env.example .env
#
# Production domain: https://slotwise.hindaralabs.com
#
# NOTE: Stripe, Twilio, Postmark, and Webflow client credentials can also be
# managed in Platform admin (encrypted in Postgres). Env values are used as
# bootstrap / fallback when admin fields are empty.
#   Stripe  → /platform/stripe
#   Twilio / Email / Webflow → /platform/settings
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public URL of this deployment (no trailing slash).
# Local:  http://localhost:3000
# Prod:   https://slotwise.hindaralabs.com
NEXT_PUBLIC_APP_URL=https://slotwise.hindaralabs.com

# Node environment: development | production | test
NODE_ENV=production

# -----------------------------------------------------------------------------
# Database (PostgreSQL + Prisma)
# -----------------------------------------------------------------------------
# Local example:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slotwise?schema=public
#
# Production: use your managed Postgres URL (Neon, Railway, RDS, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/slotwise?schema=public&sslmode=require

# -----------------------------------------------------------------------------
# Auth / secrets
# -----------------------------------------------------------------------------
# Used to encrypt Webflow/Stripe tokens at rest and sign sessions.
# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-long-random-secret

# NextAuth (required for /login, /dashboard, /platform)
# Keep NEXTAUTH_URL in sync with NEXT_PUBLIC_APP_URL
NEXTAUTH_URL=https://slotwise.hindaralabs.com
NEXTAUTH_SECRET=replace-with-long-random-secret

# Optional overrides for seeded demo users (defaults shown)
# SEED_PLATFORM_PASSWORD=SlotwiseOwner!2026
# SEED_SITE_PASSWORD=StudioOwner!2026

# -----------------------------------------------------------------------------
# Webflow Hybrid App (Designer Extension + Data Client)
# -----------------------------------------------------------------------------
# Create an app in Webflow → Workspace → Apps & Integrations → Develop
# Redirect URI must match EXACTLY (HTTPS in production):
#   https://slotwise.hindaralabs.com/api/webflow/callback
#
# Marketplace / App Install URL (no Slotwise login):
#   https://slotwise.hindaralabs.com/api/webflow/install
WEBFLOW_CLIENT_ID=
WEBFLOW_CLIENT_SECRET=
WEBFLOW_REDIRECT_URI=https://slotwise.hindaralabs.com/api/webflow/callback

# Suggested OAuth scopes (least privilege for P0):
# authorized_user:read
# sites:read sites:write
# pages:read pages:write
# cms:read cms:write
# custom_code:read custom_code:write

# -----------------------------------------------------------------------------
# Stripe (platform + Connect — Slotwise takes 0% commission)
# -----------------------------------------------------------------------------
# Dashboard: https://dashboard.stripe.com
# Webhook endpoint (prod):
#   https://slotwise.hindaralabs.com/api/stripe/webhook
# Events to enable:
#   payment_intent.succeeded
#   account.updated
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Use sk_test_ / pk_test_ / test webhook secret while developing locally.

# -----------------------------------------------------------------------------
# Email (optional for local; recommended in production)
# -----------------------------------------------------------------------------
# Confirmations + reminders. Without a token, emails are logged to the server console.
POSTMARK_API_TOKEN=
# From address must be verified with your provider
EMAIL_FROM=tidyflaw@gmail.com

# -----------------------------------------------------------------------------
# SMS / WhatsApp (P1 — optional)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Local development quick-start (optional override block)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000
# WEBFLOW_REDIRECT_URI=http://localhost:3000/api/webflow/callback
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slotwise?schema=public
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NODE_ENV=development
