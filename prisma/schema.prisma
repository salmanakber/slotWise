generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_OWNER
  PLATFORM_OPS
  WORKSPACE_OWNER
  WORKSPACE_MANAGER
  STAFF
}

enum PlanTier {
  FREE
  PRO
  BUSINESS
  AGENCY
}

enum SiteStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  DEPOSIT
  PAID
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentMode {
  FULL
  DEPOSIT
  PAY_ON_SITE
}

enum WidgetLayout {
  INLINE
  POPUP
  FLOATING
}

enum LoaderStyle {
  PULSE
  SPIN
  DRAW
  CALENDAR
}

enum AuditScope {
  PLATFORM
  WORKSPACE
  SITE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(WORKSPACE_OWNER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships Membership[]
  auditLogs   AuditLog[]   @relation("AuditActor")
  staffProfile Staff?
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  sites       Site[]
}

model Membership {
  id          String @id @default(cuid())
  role        Role   @default(WORKSPACE_OWNER)
  userId      String
  workspaceId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Plan {
  id              String   @id @default(cuid())
  tier            PlanTier @unique
  name            String
  priceMonthly    Int      @default(0) // cents
  priceYearly     Int      @default(0) // cents
  bookingsLimit   Int? // null = unlimited
  staffLimit      Int?
  sitesLimit      Int?
  themesLimit     Int      @default(2)
  stripePriceMoId String?
  stripePriceYrId String?
  features        Json     @default("[]")
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  sites Site[]
}

model Site {
  id              String     @id @default(cuid())
  publicKey       String     @unique @default(cuid())
  name            String
  status          SiteStatus @default(ACTIVE)
  timezone        String     @default("UTC")
  locale          String     @default("en")
  currency        String     @default("USD")
  webflowSiteId   String?    @unique
  webflowSiteName String?
  customCodeApplied Boolean  @default(false)
  lastSeenAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  branding        Branding?
  webflowToken    WebflowToken?
  stripeAccount   StripeAccount?
  integrations    SiteIntegration[]
  services        Service[]
  staff           Staff[]
  locations       Location[]
  availability    WeeklyAvailability[]
  timeOff         TimeOff[]
  bookings        Booking[]
  intakeFields    IntakeField[]
  notificationSettings NotificationSettings?

  @@index([workspaceId])
  @@index([status])
}

model Branding {
  id           String       @id @default(cuid())
  siteId       String       @unique
  site         Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  themeKey     String       @default("amber-light")
  accent       String       @default("#f5a000")
  inkColor     String?
  radius       Int          @default(14)
  font         String       @default("Manrope")
  buttonStyle  String       @default("solid")
  density      String       @default("comfortable")
  layout       WidgetLayout @default(INLINE)
  businessName String?
  showStaff    Boolean      @default(true)
  showPrice    Boolean      @default(true)
  showDuration Boolean      @default(true)
  showBadge    Boolean      @default(true)
  showLoader   Boolean      @default(true)
  loaderStyle  LoaderStyle  @default(PULSE)
  customCss    String?
  updatedAt    DateTime     @updatedAt
}

model WebflowToken {
  id                    String   @id @default(cuid())
  siteId                String   @unique
  site                  Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  accessTokenEncrypted  String
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  scopes                String[] @default([])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model StripeAccount {
  id                 String   @id @default(cuid())
  siteId             String   @unique
  site               Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  stripeAccountId    String?  @unique
  chargesEnabled     Boolean  @default(false)
  payoutsEnabled     Boolean  @default(false)
  paymentMode        PaymentMode @default(DEPOSIT)
  depositPercent     Int      @default(30)
  cancelFreeHours    Int      @default(24)
  noShowFeePercent   Int      @default(25)
  saveCardForNoShow  Boolean  @default(true)
  taxMode            String   @default("added")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Service {
  id              String   @id @default(cuid())
  siteId          String
  site            Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  category        String?
  color           String?  @default("#f5a000")
  locationType    String   @default("onsite") // onsite | online | phone | hybrid
  capacity        Int      @default(1)
  durationMin     Int
  priceCents      Int      @default(0)
  bufferBeforeMin Int      @default(0)
  bufferAfterMin  Int      @default(15)
  minNoticeMin    Int      @default(240)
  maxPerDay       Int?
  active          Boolean  @default(true)
  featured        Boolean  @default(false)
  cmsItemId       String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]
  staff    StaffService[]

  @@index([siteId, active])
  @@index([siteId, category])
}

model Staff {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  userId    String?  @unique
  user      User?    @relation(fields: [userId], references: [id])
  name      String
  email     String?
  active    Boolean  @default(true)
  cmsItemId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     StaffService[]
  availability WeeklyAvailability[]
  timeOff      TimeOff[]
  bookings     BookingStaff[]

  @@index([siteId])
}

model StaffService {
  staffId   String
  serviceId String
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
}

model Location {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  timezone  String?
  active    Boolean  @default(true)
  cmsItemId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([siteId])
}

model WeeklyAvailability {
  id        String  @id @default(cuid())
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sun .. 6=Sat
  enabled   Boolean @default(true)
  startTime String  @default("09:00") // HH:mm
  endTime   String  @default("17:00")

  @@index([siteId, staffId, dayOfWeek])
  @@index([siteId])
}

model TimeOff {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  staffId   String?
  staff     Staff?   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([siteId, startsAt, endsAt])
}

model IntakeField {
  id        String  @id @default(cuid())
  siteId    String
  site      Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  label     String
  fieldType String // text | select | file | consent
  required  Boolean @default(false)
  options   Json?
  sortOrder Int     @default(0)
  active    Boolean @default(true)

  @@index([siteId])
}

model Booking {
  id              String        @id @default(cuid())
  reference       String        @unique
  siteId          String
  site            Site          @relation(fields: [siteId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id])
  status          BookingStatus @default(PENDING)
  startsAt        DateTime
  endsAt          DateTime
  timezone        String
  customerName    String
  customerEmail   String
  customerPhone   String?
  notes           String?
  intakeAnswers   Json?
  amountCents     Int           @default(0)
  depositCents    Int           @default(0)
  currency        String        @default("USD")
  stripePaymentId String?
  manageToken     String        @unique @default(cuid())
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  staff BookingStaff[]

  @@index([siteId, startsAt])
  @@index([siteId, status])
  @@index([customerEmail])
}

model BookingStaff {
  bookingId String
  staffId   String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([bookingId, staffId])
}

model NotificationSettings {
  id                 String  @id @default(cuid())
  siteId             String  @unique
  site               Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  emailConfirm       Boolean @default(true)
  emailReminderHours Int     @default(24)
  emailFollowUp      Boolean @default(true)
  smsEnabled         Boolean @default(false)
  whatsappEnabled    Boolean @default(false)
  quietHours         String  @default("21:00-08:00")
  tone               String  @default("friendly")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  phase       String // P0 | P1 | P2
  enabled     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model PlatformConfig {
  id String @id @default("platform")

  // Stripe platform
  stripeMode                       String  @default("test") // test | live
  stripePublishableKey             String?
  stripeSecretKeyEncrypted         String?
  stripeWebhookSecretEncrypted     String?
  applicationFeePercent            Int     @default(0)
  stripeRequireOnboarding          Boolean @default(true)
  stripeAllowDeposits              Boolean @default(true)
  stripeAllowPayOnSite             Boolean @default(true)
  stripeSaveCardForNoShow          Boolean @default(true)

  // Email
  emailProvider                    String  @default("resend")
  emailFrom                        String?
  postmarkTokenEncrypted           String? // stores Resend API key (legacy column name)

  // SMS / WhatsApp (Twilio)
  smsProvider                      String  @default("twilio")
  twilioAccountSid                 String?
  twilioAuthTokenEncrypted         String?
  twilioFromNumber                 String?
  twilioWhatsappFrom               String?

  // Webflow app credentials (optional override of env)
  webflowClientId                  String?
  webflowClientSecretEncrypted     String?

  // AI (Designer event descriptions) — platform admin only
  aiProvider                       String  @default("openai") // openai | groq | template
  openaiApiKeyEncrypted            String?
  openaiModel                      String? @default("gpt-4o-mini")
  groqApiKeyEncrypted              String?
  groqModel                        String? @default("llama-3.3-70b-versatile")

  // Calendar / tools OAuth (platform-level apps)
  googleClientId                   String?
  googleClientSecretEncrypted      String?
  microsoftClientId                String?
  microsoftClientSecretEncrypted   String?
  zoomClientId                     String?
  zoomClientSecretEncrypted        String?
  zapierSigningSecretEncrypted     String?

  // Ops
  maintenanceMode                  Boolean @default(false)
  supportEmail                     String?
  updatedAt                        DateTime @updatedAt
}

model SiteIntegration {
  id                     String   @id @default(cuid())
  siteId                 String
  site                   Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider               String // google_calendar | outlook | zapier | zoom | meet
  status                 String   @default("disconnected") // disconnected | connected | error
  accessTokenEncrypted   String?
  refreshTokenEncrypted  String?
  externalAccountEmail   String?
  webhookUrl             String?
  meta                   Json?
  lastSyncAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@unique([siteId, provider])
  @@index([siteId])
}

model AuditLog {
  id        String     @id @default(cuid())
  scope     AuditScope @default(PLATFORM)
  action    String
  meta      Json?
  actorId   String?
  actor     User?      @relation("AuditActor", fields: [actorId], references: [id])
  siteId    String?
  createdAt DateTime   @default(now())

  @@index([createdAt])
  @@index([scope, createdAt])
}
